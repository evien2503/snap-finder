{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "item-location-ai-scan",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "services": [
    { "binding": "AI", "service": "ai" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "item-photos" }
  ],
  "d1_databases": [
    { "binding": "SCAN_DB", "database_name": "item-scans", "database_id": "local-dev-placeholder" }
  ],
  "kv_namespaces": [
    { "binding": "SCAN_KV", "id": "local-dev-placeholder" }
  ]
}
