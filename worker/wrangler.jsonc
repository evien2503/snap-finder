{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "item-location-ai-scan",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "item-photos" }
  ]
}
