# AI Gateway API Key (for non-vector AI features)
# Get your key from https://ai-gateway.guidesify.com
# NOTE: Never hardcode this in source code! Use this env variable instead.
VITE_AI_KEY=sk-your-key-here

# AI Vector Search Worker URL (Cloudflare Worker)
# After deploying with `wrangler deploy`, paste the URL here
# Default: http://localhost:8787 for local dev
VITE_AI_SEARCH_URL=https://item-location-ai-search.your-subdomain.workers.dev

# AI Vision Scan URL (same worker, /api/scan endpoint)
# If separate from search, set differently; otherwise same as SEARCH_URL
VITE_AI_SCAN_URL=https://item-location-ai-scan.your-subdomain.workers.dev
